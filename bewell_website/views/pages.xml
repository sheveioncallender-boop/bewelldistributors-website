<?xml version="1.0" encoding="utf-8"?>
<odoo><data noupdate="1">
    <template id="collection_cards" name="Be Well Collection Cards">
        <div class="bw-collection-grid">
            <a class="bw-collection-card" href="/be-well/collections#porcelain"><img src="/bewell_website/static/src/img/calacatta.webp" alt="Calacatta-look porcelain tile samples" loading="lazy"/><span><strong>Porcelain Tiles</strong><small>Made for considered spaces</small></span><b aria-hidden="true">↗</b></a>
            <a class="bw-collection-card" href="/be-well/collections#ceramic"><img src="/bewell_website/static/src/img/sandstone.webp" alt="Warm beige porcelain tile samples" loading="lazy"/><span><strong>Ceramic Tiles</strong><small>Texture, colour and possibility</small></span><b aria-hidden="true">↗</b></a>
            <a class="bw-collection-card" href="/be-well/collections#granite"><img src="/bewell_website/static/src/img/galaxy.webp" alt="Polished black granite samples" loading="lazy"/><span><strong>Granite &amp; Stone</strong><small>Naturally distinctive surfaces</small></span><b aria-hidden="true">↗</b></a>
        </div>
    </template>
    <template id="product_cards" name="Be Well Native Product Selection">
        <div t-if="products" class="bw-product-grid">
            <article t-foreach="products" t-as="product" class="bw-product-card">
                <a t-att-href="product.website_url" class="bw-product-photo"><img t-att-src="website.image_url(product, 'image_512')" t-att-alt="product.name" loading="lazy"/></a>
                <div class="bw-product-copy"><p class="bw-eyebrow" t-if="product.public_categ_ids"><t t-out="product.public_categ_ids.filtered(lambda c: not c.website_id or c.website_id == website)[:1].name"/></p>
                    <h3><a t-att-href="product.website_url" t-field="product.name"/></h3>
                    <div class="bw-price-row"><t t-if="website.prevent_zero_price_sale and not product_prices[product.id]['price_reduce']"><span>Contact for pricing</span></t><t t-else=""><span t-out="product_prices[product.id]['price_reduce']" t-options="{'widget': 'monetary', 'display_currency': website.currency_id}"/></t><a t-att-href="product.website_url" t-att-aria-label="'View ' + product.name">View <span aria-hidden="true">↗</span></a></div>
                </div>
            </article>
        </div>
        <div t-elif="can_shop" class="bw-empty"><h3>Discover what's next.</h3><p>Speak with our team about the latest collections and product availability.</p><a href="/contactus" class="bw-button">Ask about our products ↗</a></div>
        <div t-else="" class="bw-empty"><h3>Your collection awaits.</h3><p>Sign in to browse the catalogue available to your account.</p><a href="/web/login?redirect=/shop" class="bw-button">Sign in to shop ↗</a></div>
    </template>
    <template id="business_cta" name="Be Well Business Invitation">
        <section class="bw-business oe_structure" id="bw_business"><div class="bw-container bw-business-inner"><div><p class="bw-eyebrow">GROW WITH BE WELL</p><h2>Great spaces.<br/>Start with good partnerships.</h2><p>Sourcing for a project, stocking your store or introducing a new collection? Let’s talk about the possibilities.</p></div><div class="bw-business-actions"><a class="bw-button bw-button-light" href="/be-well/distribution#retailers">I'm a retailer <span>↗</span></a><a class="bw-button bw-button-outline-light" href="/be-well/distribution#suppliers">I'm a supplier <span>↗</span></a></div></div></section>
    </template>
    <template id="home" name="Be Well Homepage">
        <t t-call="website.layout"><div id="wrap" class="bw-page">
            <section class="bw-hero oe_structure" id="bw_hero"><div class="bw-container bw-hero-grid"><div class="bw-hero-copy"><p class="bw-eyebrow"><span class="bw-dot"/> TILES. GRANITE. BEAUTIFULLY CONSIDERED.</p><h1>Beautiful spaces.<br/>Begin with<br/><em>better surfaces.</em></h1><p class="bw-lead">Explore tiles, granite and natural stone for spaces that feel considered, from the ground up.</p><div class="bw-actions"><a href="/shop" class="bw-button">Explore the shop <span>↗</span></a><a href="/be-well/about" class="bw-text-link">Meet Be Well <span>→</span></a></div><div class="bw-hero-note"><span class="bw-line"/> Find the right foundation for your next project.</div></div><div class="bw-hero-visual"><img src="/bewell_website/static/src/img/collection.webp" alt="A contemporary interior with porcelain flooring and a statement stone island" fetchpriority="high"/><div class="bw-photo-tag"><span>THE BE WELL EDIT</span><strong>Distinctive materials.<br/>Everyday inspiration.</strong></div><span class="bw-vertical">TILES · GRANITE · STONE</span></div></div></section>
            <section class="bw-values oe_structure" id="bw_values"><div class="bw-container"><span><i class="fa fa-th-large" aria-hidden="true"/> Considered collections</span><span><i class="fa fa-globe" aria-hidden="true"/> Material possibilities</span><span><i class="fa fa-heart-o" aria-hidden="true"/> Local understanding</span><span><i class="fa fa-handshake-o" aria-hidden="true"/> Partnerships that matter</span></div></section>
            <section class="bw-section oe_structure" id="bw_collections"><div class="bw-container"><div class="bw-section-heading"><div><p class="bw-eyebrow">A MATERIAL DIFFERENCE</p><h2>Explore our collections.</h2></div><a href="/be-well/collections" class="bw-text-link">Discover the range ↗</a></div><t t-call="bewell_website.collection_cards"/></div></section>
            <section class="bw-section bw-soft" id="bw_featured"><div class="bw-container"><div class="bw-section-heading oe_structure" id="bw_featured_heading"><div><p class="bw-eyebrow">THE SURFACE EDIT</p><h2>Find your perfect finish.</h2></div><a href="/shop" class="bw-text-link">Shop all products ↗</a></div><t t-call="bewell_website.product_cards"/></div></section>
            <section class="bw-section oe_structure" id="bw_story"><div class="bw-container bw-story-grid"><div class="bw-story-art"><img src="/bewell_website/static/src/img/founder.webp" alt="Sharleen Pariag, founder of Be Well Distributors" loading="lazy"/><div class="bw-story-label">Experience that connects.</div></div><div class="bw-story-copy"><p class="bw-eyebrow">OUR STORY</p><h2>Local understanding.<br/><em>Global possibilities.</em></h2><p>Explore a considered selection of tiles, granite and stone with Be Well Distributors in Trinidad &amp; Tobago.</p><p>Founded by Sharleen Pariag, Be Well brings experience in retail, procurement and merchandising to the way we connect products and people. The right materials—and the right relationships—make all the difference.</p><a href="/be-well/about" class="bw-text-link">The story behind Be Well ↗</a></div></div></section>
            <t t-call="bewell_website.business_cta"/>
        </div></t>
    </template>
    <template id="about" name="Our Story">
        <t t-call="website.layout"><div id="wrap" class="bw-page"><section class="bw-page-intro oe_structure" id="bw_about_intro"><div class="bw-container"><p class="bw-eyebrow">MEET BE WELL</p><h1>Rooted in retail.<br/><em>Built on relationships.</em></h1><p class="bw-lead">Connecting materials, ideas and the people who bring spaces to life.</p></div></section>
        <section class="bw-section oe_structure" id="bw_about_story"><div class="bw-container bw-story-grid"><div class="bw-story-art"><img src="/bewell_website/static/src/img/founder.webp" alt="Sharleen Pariag" loading="lazy"/><div class="bw-story-label">Sharleen Pariag · Founder</div></div><div><p class="bw-eyebrow">A PERSONAL APPROACH TO PARTNERSHIP</p><h2>Knowing the market.<br/>Seeing the possibilities.</h2><p>Be Well Distributors Limited is a Trinidad and Tobago-based import and wholesale distribution company. Discover tiles, granite and stone, and speak with our team about the needs of your home, business or project.</p><p>Our founder, Sharleen Pariag, brings more than three decades of senior leadership experience across retail, procurement, merchandising and commercial operations.</p><p>From product selection and category development to merchandising and commercial planning, that experience shapes an approach grounded in practical needs and strong relationships.</p><p>Our supplier relationships reach across North America, Europe and Asia, bringing international possibilities together with local market knowledge.</p></div></div></section>
        <section class="bw-section bw-soft oe_structure" id="bw_approach"><div class="bw-container"><p class="bw-eyebrow">HOW WE WORK</p><h2>Thoughtful at every step.</h2><div class="bw-three-grid"><article class="bw-info-card"><span class="bw-number">01</span><h3>Market-aware selection</h3><p>We consider the needs of customers, retailers and projects when discussing products and collections.</p></article><article class="bw-info-card"><span class="bw-number">02</span><h3>Lasting relationships</h3><p>Clear communication, integrity and shared growth guide the way we work with suppliers and retailers.</p></article><article class="bw-info-card"><span class="bw-number">03</span><h3>Careful execution</h3><p>Attention to detail matters, from importing and warehousing to distribution and account support.</p></article></div></div></section><t t-call="bewell_website.business_cta"/></div></t>
    </template>
    <template id="collections" name="Our Collections">
        <t t-call="website.layout"><div id="wrap" class="bw-page"><section class="bw-page-intro oe_structure" id="bw_collections_intro"><div class="bw-container"><p class="bw-eyebrow">THE BE WELL COLLECTIONS</p><h1>Every surface.<br/><em>A new possibility.</em></h1><p class="bw-lead">Explore the textures, tones and finishes that shape a space. Discover tiles, granite and natural stone for your next idea.</p></div></section>
        <section class="bw-section oe_structure" id="bw_collection_details"><div class="bw-container bw-range-grid">
            <article class="bw-range-card" id="porcelain"><img src="/bewell_website/static/src/img/calacatta.webp" alt="Porcelain tile collection" loading="lazy"/><div><p class="bw-eyebrow">01 / PORCELAIN TILES</p><h2>A beautiful foundation.</h2><p>Explore porcelain tile looks, from clean contemporary tones to elegant marble-inspired patterns.</p><a href="/shop" class="bw-text-link">Browse the shop ↗</a></div></article>
            <article class="bw-range-card" id="neutrals"><img src="/bewell_website/static/src/img/sandstone.webp" alt="Beige porcelain collection" loading="lazy"/><div><p class="bw-eyebrow">02 / WARM NEUTRALS</p><h2>Warmth in every detail.</h2><p>Consider warm neutral tones and understated textures for a calm, cohesive material palette.</p><a href="/shop" class="bw-text-link">Find your favourites ↗</a></div></article>
            <article class="bw-range-card" id="granite"><img src="/bewell_website/static/src/img/galaxy.webp" alt="Black granite collection" loading="lazy"/><div><p class="bw-eyebrow">03 / DARK GRANITE</p><h2>Make a statement.</h2><p>Discover deep tones and distinctive mineral patterns. Discuss the right stone, finish and fabrication requirements for your project.</p><a href="/shop" class="bw-text-link">Explore the shop ↗</a></div></article>
            <article class="bw-range-card" id="ceramic"><img src="/bewell_website/static/src/img/ceramic.webp" alt="Ceramic wall tile collection" loading="lazy"/><div><p class="bw-eyebrow">04 / CERAMIC TILES</p><h2>A fresh perspective.</h2><p>Explore ceramic tile styles for considered wall designs. Confirm suitability and installation requirements with our team.</p><a href="/shop" class="bw-text-link">Discover ceramic tiles ↗</a></div></article>
            <article class="bw-range-card" id="light-granite"><img src="/bewell_website/static/src/img/whitegranite.webp" alt="Light granite collection" loading="lazy"/><div><p class="bw-eyebrow">05 / LIGHT GRANITE</p><h2>Naturally individual.</h2><p>Explore light granite tones and natural variation for a distinctive material selection.</p><a href="/shop" class="bw-text-link">Discover the collection ↗</a></div></article>
            <article class="bw-range-card" id="natural-stone"><img src="/bewell_website/static/src/img/travertine.webp" alt="Travertine collection" loading="lazy"/><div><p class="bw-eyebrow">06 / NATURAL STONE</p><h2>Texture with character.</h2><p>Discover natural stone textures and variation. Ask about available materials, finishes and project suitability.</p><a href="/contactus" class="bw-text-link">Ask about natural stone ↗</a></div></article>
        </div></section>
        <section class="bw-section bw-soft" t-if="categories"><div class="bw-container"><p class="bw-eyebrow">BROWSE THE CATALOGUE</p><h2>Shop by category.</h2><div class="bw-category-links"><a t-foreach="categories" t-as="category" t-att-href="'/shop/category/' + request.env['ir.http']._slug(category)"><span t-field="category.name"/> ↗</a></div></div></section><t t-call="bewell_website.business_cta"/></div></t>
    </template>
    <template id="distribution" name="For Retailers and Suppliers">
        <t t-call="website.layout"><div id="wrap" class="bw-page"><section class="bw-page-intro oe_structure" id="bw_business_intro"><div class="bw-container"><p class="bw-eyebrow">FOR PROJECTS, RETAILERS &amp; SUPPLIERS</p><h1>Let’s build<br/><em>something lasting.</em></h1><p class="bw-lead">A conversation about the right materials, the right quantities and the right partnership for your business or project.</p><a href="/contactus" class="bw-button">Start a conversation ↗</a></div></section>
        <section class="bw-section oe_structure" id="bw_partners"><div class="bw-container bw-two-grid"><article class="bw-partner-panel" id="retailers"><p class="bw-eyebrow">FOR RETAILERS &amp; PROJECTS</p><h2>Bring your next<br/>project to life.</h2><p>Tell us about your store or project, the material you have in mind and the quantities you need. We’ll discuss product options and availability.</p><ul class="bw-checklist"><li>Tile, granite and stone selection</li><li>Quantity, finish and availability enquiries</li><li>Retail and project requirements</li><li>Ongoing account and distribution support</li></ul><a href="/contactus" class="bw-button">Enquire about wholesale ↗</a></article><article class="bw-partner-panel bw-partner-sage" id="suppliers"><p class="bw-eyebrow">FOR SUPPLIERS</p><h2>Your brand.<br/>A new connection.</h2><p>Introduce your tile, granite or stone collection and tell us about the products, supply capabilities and markets you would like to discuss.</p><ul class="bw-checklist"><li>Local market and category understanding</li><li>International sourcing relationships</li><li>Importing, warehousing and distribution</li><li>Retail positioning and brand development</li></ul><a href="/contactus" class="bw-button">Introduce your brand ↗</a></article></div></section>
        <section class="bw-section bw-soft oe_structure" id="bw_process"><div class="bw-container"><p class="bw-eyebrow">A CLEAR START</p><h2>From introduction to opportunity.</h2><div class="bw-three-grid"><article class="bw-info-card"><span class="bw-number">01</span><h3>Tell us your story</h3><p>Share your business, location and the products or categories you're interested in.</p></article><article class="bw-info-card"><span class="bw-number">02</span><h3>Explore the fit</h3><p>We'll discuss the range, market, availability and practical requirements together.</p></article><article class="bw-info-card"><span class="bw-number">03</span><h3>Plan the next step</h3><p>Agree the commercial details and a sensible way to move the partnership forward.</p></article></div></div></section></div></t>
    </template>
    <template id="contact" name="Contact Be Well">
        <t t-call="website.layout"><div id="wrap" class="bw-page"><section class="bw-page-intro oe_structure" id="bw_contact_intro"><div class="bw-container"><p class="bw-eyebrow">LET'S CONNECT</p><h1>A good conversation<br/><em>starts here.</em></h1><p class="bw-lead">Choosing materials, planning a project or exploring a trade partnership? We’d love to hear from you.</p></div></section><section class="bw-section oe_structure" id="bw_contact_details"><div class="bw-container bw-two-grid"><div><p class="bw-eyebrow">BE WELL DISTRIBUTORS LIMITED</p><h2>Here to help.</h2><div class="bw-contact-row"><span>Call us</span><a href="tel:+18682992160">+1 (868) 299-2160 ↗</a></div><div class="bw-contact-row"><span>Email us</span><a href="mailto:info@bewelldistributorsltd.com">info@bewelldistributorsltd.com ↗</a></div><div class="bw-contact-row"><span>Based in</span><strong>Chaguanas, Trinidad</strong></div><p class="bw-small">Please contact our team to arrange a visit.</p></div><div class="bw-partner-panel bw-partner-sage"><h2>What can we help with?</h2><p>For product enquiries, include the material, size, finish and quantity required. For trade or project enquiries, tell us your company name and location.</p><a class="bw-button" href="/contactus">Send an enquiry ↗</a><p class="bw-small bw-space-top">Already a customer? <a href="/my">Access your account →</a></p></div></div></section><section class="bw-section bw-soft oe_structure" id="bw_faq"><div class="bw-container bw-faq"><p class="bw-eyebrow">A FEW HELPFUL ANSWERS</p><h2>Before you get in touch.</h2><details><summary>How do I request a project quotation?</summary><p>Send the material or product name, dimensions, quantity and project location. Our team can discuss availability and commercial terms.</p></details><details><summary>Can I confirm the finish and material before ordering?</summary><p>Please contact our team to discuss finishes, sizes and samples. Natural stone can vary in colour and pattern; confirm the material selection before purchase.</p></details><details><summary>Where can I confirm delivery and returns information?</summary><p>Contact our team before ordering to confirm delivery availability, charges and the returns terms applicable to your purchase.</p></details></div></section></div></t>
    </template>
</data></odoo>
